{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role and enrollment data",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["admin", "student"] },
        "phone": { "type": "string", "maxLength": 30 },
        "enrolledCourseIds": { "type": "array" },
        "joinDate": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Course": {
      "title": "Course",
      "description": "Educational course item with modules and pricing",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "titleBn": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 50 },
        "feeBDT": { "type": "number" },
        "discountBDT": { "type": "number" },
        "instructor": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "title", "titleBn", "category", "feeBDT"]
    },
    "FeeRecord": {
      "title": "FeeRecord",
      "description": "Financial ledger record for student fee tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentEmail": { "type": "string", "maxLength": 120 },
        "courseId": { "type": "string", "maxLength": 128 },
        "totalFee": { "type": "number" },
        "paidAmount": { "type": "number" },
        "balance": { "type": "number" },
        "status": { "type": "string", "enum": ["verified", "pending", "rejected"] }
      },
      "required": ["id", "studentId", "studentEmail", "courseId", "totalFee", "paidAmount", "balance", "status"]
    },
    "Certificate": {
      "title": "Certificate",
      "description": "Issued completion credential",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "certificateNumber": { "type": "string", "maxLength": 64 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 100 },
        "courseId": { "type": "string", "maxLength": 128 },
        "issueDate": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "certificateNumber", "studentId", "studentName", "courseId", "issueDate"]
    },
    "Notice": {
      "title": "Notice",
      "description": "Institute circular or class routine schedule",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "content": { "type": "string", "maxLength": 2000 },
        "category": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "title", "content"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Configurable site content, hero banner, and contact information",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "heroTitleBn": { "type": "string", "maxLength": 300 },
        "heroSubtitleBn": { "type": "string", "maxLength": 1000 },
        "heroBannerUrl": { "type": "string", "maxLength": 500 },
        "hotline": { "type": "string", "maxLength": 50 },
        "emailContact": { "type": "string", "maxLength": 100 }
      },
      "required": ["id"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/User",
      "description": "User profile records"
    },
    "/admins/{adminId}": {
      "schema": "#/entities/User",
      "description": "Institute administrator registry"
    },
    "/courses/{courseId}": {
      "schema": "#/entities/Course",
      "description": "Course catalog and modules"
    },
    "/fees/{feeId}": {
      "schema": "#/entities/FeeRecord",
      "description": "Student payment and ledger records"
    },
    "/certificates/{certificateId}": {
      "schema": "#/entities/Certificate",
      "description": "Authentic verified certificates"
    },
    "/notices/{noticeId}": {
      "schema": "#/entities/Notice",
      "description": "Public and student notices"
    },
    "/settings/{settingId}": {
      "schema": "#/entities/SiteSettings",
      "description": "Website customization and contact configuration"
    }
  }
}
